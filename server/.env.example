# =====================================================
# PLANTILLA DE VARIABLES DE ENTORNO - ReJuega Server
# Copia este archivo como .env y completa tus datos:
#   copy .env.example .env   (Windows)
# =====================================================

# Puerto del servidor
PORT=3000

# Conexion a MySQL local
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=TU_CONTRASENA_MYSQL
DB_NAME=rejuega_db
DB_PORT=3306

# Origenes permitidos por CORS (* para desarrollo)
ALLOWED_ORIGINS=*